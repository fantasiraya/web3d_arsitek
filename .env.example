APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ── MySQL (uncomment jika pakai MySQL) ──
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=web3d_arsitek
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pitcharch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Mail untuk Production (pilih salah satu) ──
#
# Opsi 1 — SMTP Gmail (pakai App Password, bukan password akun):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your@gmail.com
#   MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx  (Google App Password)
#   MAIL_SCHEME=tls
#
# Opsi 2 — Mailtrap (untuk testing staging):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<mailtrap_username>
#   MAIL_PASSWORD=<mailtrap_password>
#   MAIL_SCHEME=null
#
# Opsi 3 — Resend / Mailgun / SES (production):
#   MAIL_MAILER=resend   # atau mailgun / ses
#   RESEND_API_KEY=re_xxxx
#   MAILGUN_DOMAIN=pitcharch.id
#   MAILGUN_SECRET=key-xxxx
#

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Google OAuth ──
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat "OAuth 2.0 Client ID" dengan tipe "Web application"
# 3. Tambahkan Authorized redirect URI: http://localhost:8000/auth/google/callback
# 4. Salin Client ID dan Client Secret ke sini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Laravel Reverb (WebSocket Realtime Chat) ──
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Passkeys (WebAuthn/FIDO2) ──
# Generate dengan: php artisan key:generate --show
# Wajib diisi agar passkey user handle bisa di-encrypt/decrypt dengan aman
PASSKEYS_USER_HANDLE_SECRET=
